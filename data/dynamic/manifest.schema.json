{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["repository", "commit", "groups", "budgets"],
  "properties": {
    "repository": {"type": "string"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "seeds": {"type": "array", "items": {"type": "integer"}, "default": [7, 17, 27]},
    "budgets": {
      "type": "object",
      "required": ["attempts", "planning_steps", "execution_steps", "model_calls", "tokens", "task_seconds", "request_seconds", "max_output_tokens", "score_seconds", "reserved_scoring_seconds"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "planning_steps": {"type": "integer", "minimum": 1},
        "execution_steps": {"type": "integer", "minimum": 1},
        "model_calls": {"type": "integer", "minimum": 1},
        "tokens": {"type": "integer", "minimum": 1},
        "task_seconds": {"type": "number", "exclusiveMinimum": 0},
        "request_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "score_seconds": {"type": "number", "exclusiveMinimum": 0},
        "reserved_scoring_seconds": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "groups": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["id", "tasks", "regression_checks"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "regression_checks": {"$ref": "#/$defs/commands"},
          "tasks": {
            "type": "array", "minItems": 4, "maxItems": 4,
            "items": {
              "type": "object", "required": ["id", "instruction", "allowed_writes", "checks"],
              "properties": {
                "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
                "instruction": {"type": "string", "minLength": 1},
                "allowed_writes": {"type": "array", "items": {"type": "string"}},
                "checks": {"$ref": "#/$defs/commands"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "commands": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
  },
  "additionalProperties": false
}
